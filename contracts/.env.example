# Base network RPCs
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Verification
BASESCAN_API_KEY=your_basescan_api_key

# Treasury wallet (receives protocol fees, GENESIS withdrawals + royalties)
TREASURY_WALLET=0x0000000000000000000000000000000000000000

# Deployed factory addresses (filled after deploy)
TOKEN_FACTORY_BASE_SEPOLIA=
NFT_FACTORY_BASE_SEPOLIA=
TOKEN_FACTORY_BASE=
NFT_FACTORY_BASE=

# --- GENESIS PASS (see DEPLOY_GENESIS.md) ---
GENESIS_OWNER=0x0000000000000000000000000000000000000000
GENESIS_BASE_URI=ipfs://your_metadata_cid/
# Unix timestamp the 7-day mint window opens
GENESIS_MINT_START=
# optional overrides
GENESIS_MINT_DURATION=604800
GENESIS_PRICE_WEI=500000000000000
GENESIS_ROYALTY_BPS=500

# Deployed GENESIS PASS addresses (filled after deploy)
GENESIS_PASS_BASE_SEPOLIA=
GENESIS_PASS_BASE=
